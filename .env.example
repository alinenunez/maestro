PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SistemaMaestro
DB_USER=postgres
DB_PASSWORD=

# Chave aleatoria de pelo menos 32 caracteres para assinar JWT. Nunca versionar o valor real.
JWT_SECRET=
# Chave local para autorizar apenas o primeiro cadastro de administrador.
# Enviar no cabecalho X-Setup-Token; deixar vazia apos concluir o cadastro inicial.
ADMIN_SETUP_TOKEN=
