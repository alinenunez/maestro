PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SistemaMaestro
DB_USER=postgres
DB_PASSWORD=

# Chave aleatoria de pelo menos 32 caracteres para assinar JWT. Nunca versionar o valor real.
JWT_SECRET=
# Chave local para autorizar apenas o primeiro cadastro de administrador.
# Enviar no cabecalho X-Setup-Token; deixar vazia apos concluir o cadastro inicial.
ADMIN_SETUP_TOKEN=

# Recuperacao pelo Gmail: SMTP_USER e EMAIL_FROM recebem o mesmo endereco completo.
# SMTP_PASSWORD recebe uma senha de app do Google. Nunca versionar credenciais reais.
# Porta 587 usa SMTP_SECURE=false com STARTTLS; porta 465 usa SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
RESET_PASSWORD_URL=http://localhost:5173/redefinir-senha
